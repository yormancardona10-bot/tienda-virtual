<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Productos</title>

    <link rel="stylesheet" href="/css/estilos.css">
</head>

<body>

    <nav>
        <h2>🛒 Tienda Virtual</h2>

        <div>
            <a href="/">Inicio</a>
            <a href="/productos">Productos</a>
            <a href="/login">Iniciar sesión</a>
        </div>
    </nav>

    <main class="contenedor">

        <h1>Nuestros productos</h1>

        <div class="productos">

            <div class="producto">
                <h2>Laptop Lenovo</h2>
                <p>Laptop para trabajo y estudio.</p>
                <h3>$2.500.000</h3>
                <button>Comprar</button>
            </div>

            <div class="producto">
                <h2>iPhone</h2>
                <p>Celular de última generación.</p>
                <h3>$3.000.000</h3>
                <button>Comprar</button>
            </div>

            <div class="producto">
                <h2>Audífonos</h2>
                <p>Audífonos inalámbricos.</p>
                <h3>$150.000</h3>
                <button>Comprar</button>
            </div>

        </div>

    </main>

</body>
</html>